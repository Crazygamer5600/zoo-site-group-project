@model IEnumerable<ProjectStudioApp.Models.Animal>

@{
    ViewData["Title"] = "Animal Showcase";
}

<h2 style="color:#d2691e;">Our Amazing Animals</h2>

<div class="row g-3">
    @foreach (var animal in Model)
    {
        <div class="col-md-4">
            <div class="feature-card">
                <img src="@animal.AnimalPhoto" alt="@animal.Name" class="animal-img mb-2" />
                <h5>@animal.Name</h5>
                <p><strong>Species:</strong> @animal.Species</p>
                <p>@animal.Description</p>
                <a asp-action="Details" asp-route-id="@animal.AnimalId" class="btn btn-zoo btn-sm mt-2">Learn More</a>
            </div>
        </div>
    }
</div>

<style>
    .animal-img {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 12px;
    }
</style>
