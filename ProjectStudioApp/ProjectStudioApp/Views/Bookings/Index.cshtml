    <div class="row g-3">
        <div class="col-md-4"><div class="feature-card"><h5>Adult Ticket</h5><div class="price">$45 <small>/person</small></div></div></div>
        <div class="col-md-4"><div class="feature-card"><h5>Child Ticket</h5><div class="price">$25 <small>/person</small></div></div></div>
