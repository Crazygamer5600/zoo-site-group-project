<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zoolirante Zoo</title>


    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectStudioApp.styles.css" asp-append-version="true" />


    <style>

        /* Shared nav pill design */
        .nav-pills .nav-link {
            background-color: #EA640E;
            color: white;
            transition: background-color 0.3s ease;
        }

            .nav-pills .nav-link.active {
                background-color: #808080 !important;
                color: white;
            }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #FFDAB9 0%, #f8f4e6 100%);
            color: #333;
            line-height: 1.6;
        }

        .feature-card {
            border-radius: 15px;
            padding: 24px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,.1);
            background: white;
            transition: transform .2s ease;
        }

            .feature-card:hover {
                transform: translateY(-8px);
            }

        .btn-zoo {
            background: #ff8c42;
            color: #fff;
            border: none;
            border-radius: 25px;
            padding: .7rem 1.5rem;
        }

            .btn-zoo:hover {
                background: #ff7028;
                color: #fff;
            }

        .price {
            font-size: 1.2rem;
            font-weight: bold;
            color: #ff8c42;
        }

        .figure-img {
            width: 100px; /* same width you set */
            height: 38px; /* slightly shorter than image */
            overflow: hidden; /* hide top/bottom overflow */
            border-radius: 0.5rem; /* keeps your rounded corners */
        }

            .figure-img img {
                width: 100%;
                height: auto;
                margin-top: -100px; /* trim top */
                margin-bottom: -123px; /* trim bottom */
            }
    </style>
</head>
<body>
    <!-- ===== Navbar ===== -->
    <ul class="nav nav-pills nav-fill gap-2 p-1 small rounded-5 shadow-sm"
        style="background-color:#D9B99B;">

        <li class="figure-img rounded-3">
            
            <a class=" @(ViewData["Title"]?.ToString() == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index"><img src="https://lo.unisa.edu.au/pluginfile.php/5037007/mod_label/intro/image.png" alt="Figure" width="100"></a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5 @(ViewData["Title"]?.ToString() == "Animal Showcase" ? "active" : "")"
               asp-controller="Animals" asp-action="Index">Animal Showcase</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Events" asp-action="Index">Upcoming Events</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Bookings" asp-action="Index">Ticket Reservation</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Merchandise" asp-action="Index">Merchandise</a>
        </li>
    </ul>

    <!-- ===== Page Content and Background Colour ===== -->

    <div class="container mt-4">

        <main role="main" class="pb-3">
            <style>
                body {
                    background-color: #EA640E; /* Orange */
                }
            </style>
            @RenderBody()
        </main>
    </div>

    <!-- ===== Footer ===== -->
    <footer class="bg-dark text-light mt-5 pt-5 pb-3">
        <div class="container">
            <div class="row text-center text-md-start">
                <div class="col-md-3 mb-4">
                    <h4 style="font-weight:bold;">Zoolirante</h4>
                    <p>Experience Wildlife Wonder</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">About</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-light text-decoration-none">Our Zoo</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Education</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Conservation</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">Contact</h6>
                    <ul class="list-unstyled">
                        <li>Email: info@zoolirante.com</li>
                        <li>Phone: +61 2 1234 5678</li>
                        <li>Address: 123 Zoo Rd, Sydney</li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4 text-center">
                    <h6 class="fw-bold">Follow Us</h6>
                    <!-- social icons... -->
                    <!-- Social -->

                    <a href="https://facebook.com" target="_blank" class="btn btn-outline-primary btn-sm rounded-circle me-2 p-2">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b8/2021_Facebook_icon.svg" width="20" alt="Facebook">
                    </a>
                    <a href="https://instagram.com" target="_blank" class="btn btn-outline-danger btn-sm rounded-circle me-2 p-2">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/e/e7/Instagram_logo_2016.svg" width="20" alt="Instagram">
                    </a>
                    <a href="https://twitter.com" target="_blank" class="btn btn-outline-primary btn-sm rounded-circle me-2 p-2">
                        <img src="https://images.freeimages.com/image/large-previews/f35/x-twitter-logo-on-black-circle-5694247.png?h=350" width="20" alt="Twitter / X">
                    </a>
                    <a href="https://youtube.com" target="_blank" class="btn btn-outline-danger btn-sm rounded-circle p-2">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/0/09/YouTube_full-color_icon_%282017%29.svg" width="20" alt="YouTube">
                    </a>

                </div>
                <hr class="border-light">
                <div class="text-center small">
                    © 2025 Zoolirante Zoo. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
