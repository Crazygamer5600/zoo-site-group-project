<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zoolirante Zoo</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectStudioApp.styles.css" asp-append-version="true" />

    <style>
        /* === Shared nav pill design (keep orange everywhere) === */
        .nav-pills .nav-link {
            background-color: #EA640E !important; /* orange */
            color: #fff !important;
            transition: background-color .3s ease;
        }

            .nav-pills .nav-link.active {
                background-color: #808080 !important; /* grey when active */
                color: #fff !important;
            }

        /* Default site background (can be overridden per page) */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #FFDAB9 0%, #f8f4e6 100%);
            color: #333;
            line-height: 1.6;
        }

        .feature-card {
            border-radius: 15px;
            padding: 24px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,.1);
            background: #fff;
            transition: transform .2s ease;
        }

            .feature-card:hover {
                transform: translateY(-8px);
            }

        .btn-zoo {
            background: #ff8c42;
            color: #fff;
            border: none;
            border-radius: 25px;
            padding: .7rem 1.5rem;
        }

            .btn-zoo:hover {
                background: #ff7028;
                color: #fff;
            }

        .price {
            font-size: 1.2rem;
            font-weight: bold;
            color: #ff8c42;
        }

        .figure-img {
            width: 100px;
            height: 38px;
            overflow: hidden;
            border-radius: .5rem;
        }

            .figure-img img {
                width: 100%;
                height: auto;
                margin-top: -100px;
                margin-bottom: -123px;
            }
    </style>
</head>
<body>
    <!-- ===== Navbar ===== -->
    <ul class="nav nav-pills nav-fill gap-2 p-1 small rounded-5 shadow-sm" style="background-color:#D9B99B;">
        <li class="figure-img rounded-3">
            <a class="@(ViewData["Title"]?.ToString() == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index"><img src="~/Images/image.png" alt="Figure" width="100"></a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5 @(ViewData["Title"]?.ToString() == "Animal Showcase" ? "active" : "")"
               asp-controller="Animals" asp-action="Index">Animal Showcase</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Events" asp-action="Index">Upcoming Events</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Bookings" asp-action="Index">Ticket Reservation</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Merchandise" asp-action="Index">Merchandise</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-5" asp-controller="Membership" asp-action="Index">Membership</a>
        </li>
        <li class="figure-img">
            <a class="@(ViewData["Title"]?.ToString() == "Accounts" ? "active" : "")"
               asp-controller="Accounts" asp-action="Index"><img src="~/Images/account-icon.png" alt="Figure" style="width:35px"></a>
        </li>
        @{
            if (LoggedInUser.CurrentAccount != null)
            {
                <li class="nav-item" style="width: 0px">
                    <b class="card-header-tabs"> Welcome @LoggedInUser.CurrentAccount.FirstName</b>
                </li>
            }
        }
    </ul>

    <!-- ===== Page Content ===== -->
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ===== Notifications ===== -->
    <div id="notificationContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;"></div>

    <!-- ===== Footer ===== -->
    <footer class="bg-dark text-light mt-5 pt-5 pb-3">
        <!-- (unchanged footer markup) -->
        @* ... your footer code stays as is ... *@
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
