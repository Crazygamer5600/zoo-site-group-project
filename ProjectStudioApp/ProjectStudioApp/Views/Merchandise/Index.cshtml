@model IEnumerable<ProjectStudioApp.Models.Merchandise>

@{
    ViewData["Title"] = "Index";
}

<style>
    .merch-img {
        width: 100%;
        height: 250px;
        object-fit: contain;
        border-radius: 12px;
    }
</style>

<section id="merchandise" class="zoo-section container mt-4">
    <h2 style="color:#d2691e;">Zoo Merchandise</h2>
    @foreach (var item in Model)
    {
        <div class="card mb-3 p-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <img src="@item.ItemImage" alt="@item.ItemName" class="merch-img" />
                </div>
                <div class="col-md-8">
                    <h5>@item.ItemName</h5>
                    <p>@item.ItemDescription</p>
                    <p class="price">$@item.ItemCost</p>
                    <button class="btn btn-zoo btn-sm mt-2 add-to-cart" data-id="@item.ItemId">Add to Cart</button>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script>
        $(document).on('click', '.add-to-cart', function () {
            var id = $(this).data('id');
            $.post('/Merchandise/AddToCart', { id: id }, function (data) {
                if (data.success) {
                    
                    location.reload(); 
                }
            });
        });
    </script>
}