@model IEnumerable<ProjectStudioApp.Models.Merchandise>

@{
    ViewData["Title"] = "Index";
}

<style>
    .merch-img {
        width: 100%;
        height: 250px;
        object-fit: contain;
        border-radius: 12px;
    }
</style>

<section id="merchandise" class="zoo-section container mt-4">
    <h2 style="color:#d2691e;">Zoo Merchandise</h2>
    @foreach (var item in Model)
    {
        <div class="card mb-3 p-3">
		<div class="row g-3">
            <div class="col-md-4">
                <img src="@item.ItemImage" alt="@item.ItemName" class="merch-img" />
            </div>
            <div class="col-md-8">
                <h5>@item.ItemName</h5>
                <p>@item.ItemDescription</p>
                <p class="price">$@item.ItemCost</p>
                <a href="#" class="btn btn-zoo btn-sm mt-2">Add to Cart</a>
				</div>
                </div>
		</div>
	}
</section>