<div class="card shadow-sm mt-4" id="feedback">
    <div class="card-body">
        <h5 class="mb-3">Share your experience 🦁</h5>

        <div class="mb-3">
            <label class="form-label">Rate your visit</label><br />
            <i class="bi bi-star star"></i>
            <i class="bi bi-star star"></i>
            <i class="bi bi-star star"></i>
            <i class="bi bi-star star"></i>
            <i class="bi bi-star star"></i>
        </div>

        <div class="mb-3">
            <label class="form-label">Your feedback</label>
            <textarea class="form-control" rows="4" placeholder="Tell us what you loved about this event..."></textarea>
        </div>

        <button class="btn btn-success rounded-pill px-4">
            <i class="bi bi-send"></i> Submit
        </button>
    </div>
</div>

<style>
    .star {
        font-size: 1.4rem;
        cursor: pointer;
    }

        .star:hover, .star.active {
            color: #FFD700;
        }
</style>

<script>
    document.querySelectorAll('.star').forEach((s, i, arr) => {
      s.addEventListener('click', () => {
        arr.forEach((x, idx) => x.classList.toggle('active', idx <= i));
      });
    });
</script>
