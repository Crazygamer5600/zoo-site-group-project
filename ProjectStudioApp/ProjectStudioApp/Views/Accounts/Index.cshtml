@model IEnumerable<ProjectStudioApp.Models.Account>
@{
    ViewData["Title"] = "Accounts";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">🐾 Zoo Accounts</h2>
            <small class="text-muted">Manage your zoo visits, memberships & settings</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary">
                @((Model?.Count() ?? 0)) item(s)
            </span>
            <form method="get" asp-action="Create">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Create New
                </button>
            </form>
        </div>
    </div>

    @if (LoggedInUser.CurrentAccount == null)
    {
        <!-- FIND ACCOUNT -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title mb-3">Find your account</h5>
                <form method="post">
                    <div class="input-group mb-3">
                        <span class="input-group-text">✉️</span>
                        <input type="email" class="form-control" placeholder="Enter your email" name="Email" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Submit
                    </button>
                </form>
            </div>
        </div>

        <!-- NOT FOUND / CTA -->
        <div class="card border-0" style="background:linear-gradient(180deg,#fff7ec 0,#ffe9d6 100%);">
            <div class="card-body text-center">
                <h5 class="text-danger mb-2">No account found with this email.</h5>
                <p class="text-muted mb-3">Try a different email or create a new account.</p>
                <form method="get" asp-action="Create">
                    <button class="btn btn-success">
                        <i class="bi bi-plus-lg"></i> Create New
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- ACCOUNT SUMMARY -->
        <div class="card shadow-sm mb-3">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning-subtle border p-3">🦒</div>
                    <div>
                        <h5 class="mb-1">Welcome back!</h5>
                        <div class="text-muted small">Your account is ready to use</div>
                    </div>
                </div>
                <form asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="row g-3">
            <!-- Reservations -->
            <div class="col-md-4">
                <div class="card h-100 border-success-subtle">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <h6 class="card-title mb-1">My Reservations</h6>
                            <p class="card-text text-muted small mb-0">View upcoming & past tickets</p>
                        </div>
                        <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-primary mt-auto">Open</a>
                    </div>
                </div>
            </div>

            <!-- Membership -->
            <div class="col-md-4">
                <div class="card h-100 border-warning-subtle">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <h6 class="card-title mb-1">My Membership</h6>
                            <p class="card-text text-muted small mb-0">Renew or upgrade your plan</p>
                        </div>
                        <a asp-controller="Membership" asp-action="Index" class="btn btn-outline-primary mt-auto">Manage</a>
                    </div>
                </div>
            </div>

            <!-- Account Settings -->
            <div class="col-md-4">
                <div class="card h-100 border-info-subtle">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <h6 class="card-title mb-1">Account Settings</h6>
                            <p class="card-text text-muted small mb-0">Update profile & preferences</p>
                        </div>
                        <a asp-action="Edit" class="btn btn-outline-primary mt-auto">Edit</a>
                        @* If your Edit needs an id, change to: asp-route-id="..." *@
                    </div>
                </div>
            </div>

            <!-- Profile Management (NEW) -->
            <div class="col-md-4">
                <div class="card h-100 border-secondary-subtle">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <h6 class="card-title mb-1">Profile Management</h6>
                            <p class="card-text text-muted small mb-0">Update your contact details</p>
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <!-- Navigate to your existing Edit page -->
                            <a asp-action="Edit" class="btn btn-outline-primary flex-fill">Edit Profile</a>

                            <!-- Inline update using Bootstrap modal -->
                            <button type="button" class="btn btn-secondary flex-fill"
                                    data-bs-toggle="modal" data-bs-target="#profileModal">
                                Update Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- /row -->
    }
</div> <!-- /container -->
<!-- Profile Update Modal (NEW) -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="profileModalLabel">Update Contact Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- POST to your existing Edit action (change if you use a different action) -->
            <form method="post" asp-action="Edit">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full name</label>
                            <input name="FullName" class="form-control" value="@((ViewBag?.ProfileFullName as string) ?? "")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input name="Email" type="email" class="form-control" value="@((ViewBag?.ProfileEmail as string) ?? "")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input name="Phone" class="form-control" value="@((ViewBag?.ProfilePhone as string) ?? "")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Alternate phone (optional)</label>
                            <input name="AltPhone" class="form-control" value="@((ViewBag?.ProfileAltPhone as string) ?? "")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address line 1</label>
                            <input name="Address1" class="form-control" value="@((ViewBag?.ProfileAddress1 as string) ?? "")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address line 2 (optional)</label>
                            <input name="Address2" class="form-control" value="@((ViewBag?.ProfileAddress2 as string) ?? "")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">City</label>
                            <input name="City" class="form-control" value="@((ViewBag?.ProfileCity as string) ?? "")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">State/Region</label>
                            <input name="State" class="form-control" value="@((ViewBag?.ProfileState as string) ?? "")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Postcode</label>
                            <input name="Postcode" class="form-control" value="@((ViewBag?.ProfilePostcode as string) ?? "")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Country</label>
                            <input name="Country" class="form-control" value="@((ViewBag?.ProfileCountry as string) ?? "")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Preferred contact method</label>
                            <select name="PreferredContact" class="form-select">
                                <option value="">Select…</option>
                                <option>Email</option>
                                <option>Phone</option>
                                <option>SMS</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
